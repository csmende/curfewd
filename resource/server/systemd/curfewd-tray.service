[Unit]
Description=curfewd desktop tray, countdown HUD & notification companion
Documentation=https://github.com/csmende/curfewd
After=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/curfewd-tray
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
