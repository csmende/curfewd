#!/bin/sh
set -e

TK_DIR="/usr/lib/python3/dist-packages/timekpr"
TK_UNIT_NAME="timekpr.service"

# Add timekpr group (for accessing administration functionality without sudo)
getent group timekpr >/dev/null || groupadd -r timekpr

# Remove stale compiled python units
if [ -d "${TK_DIR}" ]; then
    find "${TK_DIR}" -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
    find "${TK_DIR}" -type f -iname '*.pyc' -delete 2>/dev/null || true
fi

# Remove obsolete unit previously installed under /etc
TK_OBSOLETE_UNIT="/etc/systemd/system/${TK_UNIT_NAME}"
if [ -f "${TK_OBSOLETE_UNIT}" ] && [ ! -L "${TK_OBSOLETE_UNIT}" ]; then
    rm -f "${TK_OBSOLETE_UNIT}"
fi

# Enable/reload/restart systemd units when running under systemd
if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl reload dbus 2>/dev/null || true
    systemctl enable "${TK_UNIT_NAME}" || true
    systemctl restart "${TK_UNIT_NAME}" || true
fi

# Update GTK icon cache when utility exists
if command -v gtk-update-icon-cache >/dev/null 2>&1 && [ -d /usr/share/icons/hicolor ]; then
    touch --no-create /usr/share/icons/hicolor || true
    gtk-update-icon-cache -f -q /usr/share/icons/hicolor || true
fi

#DEBHELPER#
