#!/bin/sh
set -e

TK_DIR="/usr/lib/python3/dist-packages/timekpr"
TK_UNIT_NAME="timekpr.service"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
        systemctl stop "${TK_UNIT_NAME}" 2>/dev/null || true
        systemctl disable "${TK_UNIT_NAME}" 2>/dev/null || true
        systemctl reload dbus 2>/dev/null || true
        systemctl daemon-reload || true
    fi
fi

if [ -d "${TK_DIR}" ]; then
    find "${TK_DIR}" -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
    find "${TK_DIR}" -type f -iname '*.pyc' -delete 2>/dev/null || true
fi

#DEBHELPER#
